generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DRIVER
}

enum DeliveryStatus {
  PENDING
  COMPLETED
}

enum BillStatus {
  DRAFT
  SENT
  PAID
}

enum InventoryLogType {
  DELIVERY_OUT
  COLLECTION_IN
  ADMIN_RESTOCK
  ADMIN_EMPTY_DISPATCH
  MANUAL_ADJUSTMENT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  mobile       String
  role         Role
  loginId      String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver     Driver?
  deliveries Delivery[]
}

model Driver {
  id            String   @id @default(cuid())
  userId        String   @unique
  vehicleNumber String
  vehicleType   String
  route         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  clients    Client[]
  deliveries Delivery[]
}

model Client {
  id                  String   @id @default(cuid())
  name                String
  mobile              String
  email               String?
  address             String   @db.Text
  assignedDriverId    String
  route               String
  tempoNumber         String
  ratePerBottle       Decimal  @default(50) @db.Decimal(10, 2)
  outstandingBalance  Decimal  @default(0) @db.Decimal(10, 2)
  creditBalance       Decimal  @default(0) @db.Decimal(10, 2)
  totalBottlesDelivered Int    @default(0)
  totalBottlesCollected Int    @default(0)
  bottlesOut          Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // PHASE 2a (multi-location): nullable for now so the backfill script can
  // migrate existing rows safely; money logic still reads/writes Client
  // directly until phase 2b re-points it at Customer.
  customerId String?

  assignedDriver Driver            @relation(fields: [assignedDriverId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id])
  deliveries     Delivery[]
  invoices       Invoice[]
  monthlyBills   MonthlyBill[]
  paymentHistory PaymentHistory[]
}

// PHASE 2a (multi-location): the entity above Client — a customer may have
// one or many Client "locations". Added with balances copied up from each
// linked Client by backfill-customers.js; no money logic reads/writes this
// yet (that's phase 2b).
model Customer {
  id                 String   @id @default(cuid())
  name               String
  outstandingBalance Decimal  @default(0) @db.Decimal(10, 2)
  creditBalance      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clients Client[]
}

model Delivery {
  id                     String         @id @default(cuid())
  clientId               String
  driverId               String
  userId                 String?
  deliveryDate           DateTime
  filledBottlesDelivered Int
  emptyBottlesCollected  Int
  status                 DeliveryStatus @default(PENDING)
  notes                  String?        @db.Text
  isHistorical           Boolean        @default(false)
  createdAt              DateTime       @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  driver  Driver   @relation(fields: [driverId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  invoice Invoice?
}

model MonthlyBill {
  id                    String     @id @default(cuid())
  clientId              String
  month                 Int
  year                  Int
  totalBottlesDelivered Int
  totalEmptyCollected   Int
  ratePerBottle         Decimal    @db.Decimal(10, 2)
  totalAmount           Decimal    @db.Decimal(10, 2)
  status                BillStatus @default(DRAFT)
  whatsappSentAt        DateTime?
  paidAt                DateTime?
  pdfPath               String?    @db.Text
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, month, year])
}

model Invoice {
  id                        String    @id @default(cuid())
  clientId                  String
  deliveryId                String    @unique
  invoiceNumber             String    @unique
  bottlesTakenSinceLastPaid Int
  amountPerBottle           Decimal   @db.Decimal(10, 2)
  totalAmount               Decimal   @db.Decimal(10, 2)
  isPaid                    Boolean   @default(false)
  paidAt                    DateTime?
  amountPaid                Decimal   @default(0) @db.Decimal(10, 2)
  paymentMethod             String?
  paymentQrData             String?   @db.Text
  isHistorical              Boolean   @default(false)
  createdAt                 DateTime  @default(now())

  client   Client   @relation(fields: [clientId], references: [id])
  delivery Delivery @relation(fields: [deliveryId], references: [id])
}

model PaymentHistory {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  invoiceId     String?
  amountPaid    Decimal  @db.Decimal(10, 2)
  paymentMethod String
  balanceBefore Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @db.Decimal(10, 2)
  recordedBy    String
  note          String?  @db.Text
  createdAt     DateTime @default(now())
}

// Single-row settings table (id fixed at 1) for business-wide config that
// isn't tied to any one client/driver — currently just the invoice PDF's
// signature/stamp images.
model BusinessSettings {
  id            Int      @id @default(1)
  signaturePath String?  @db.Text
  stampPath     String?  @db.Text
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

model BottleInventory {
  id                 Int      @id
  totalFilledBottles Int      @default(0)
  totalEmptyBottles  Int      @default(0)
  lastUpdatedAt      DateTime @updatedAt
  updatedBy          String
}

model InventoryLog {
  id                 String           @id @default(cuid())
  type               InventoryLogType
  filledChange       Int
  emptyChange        Int
  filledBalanceAfter Int
  emptyBalanceAfter  Int
  referenceId        String?
  note               String?          @db.Text
  createdBy          String
  createdAt          DateTime         @default(now())
}
